{
  "name": "diff-viz-cli",
  "version": "1.11.0",
  "type": "module",
  "description": "Local git change review visualizer: dependency topology, code diffs, impact analysis and review todos.",
  "bin": {
    "diff-viz": "bin/diff-viz.mjs"
  },
  "files": [
    "bin",
    "src",
    "dist",
    "SKILL.md",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "vite build",
    "dev:web": "vite",
    "test": "node --test",
    "typecheck": "tsc --noEmit",
    "demo": "node scripts/demo.mjs",
    "package:skill": "node scripts/build-skill-package.mjs",
    "package:skill:standalone": "node scripts/build-skill-package.mjs --standalone",
    "release:check": "node scripts/check-changelog.mjs",
    "prepublishOnly": "npm run release:check && npm run typecheck && npm test && npm run build"
  },
  "keywords": [
    "git",
    "diff",
    "code-review",
    "dependency-graph",
    "impact-analysis",
    "visualization",
    "cli",
    "agent-skill",
    "typescript",
    "python",
    "go",
    "java"
  ],
  "author": "mdhUser",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mdhUser/diff-viz.git"
  },
  "homepage": "https://github.com/mdhUser/diff-viz#readme",
  "bugs": {
    "url": "https://github.com/mdhUser/diff-viz/issues"
  },
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=20"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.5",
    "@types/dagre": "^0.7.54",
    "@types/node": "^22.20.5",
    "@types/react": "^18.3.31",
    "@types/react-dom": "^18.3.7",
    "@vitejs/plugin-react": "^5.2.0",
    "@xyflow/react": "^12.12.1",
    "dagre": "^0.8.5",
    "lucide-react": "^0.468.0",
    "react": "^18.3.1",
    "react-diff-viewer-continued": "^4.4.0",
    "react-dom": "^18.3.1",
    "tailwindcss": "^4.3.5",
    "typescript": "^5.9.3",
    "vite": "^7.3.8"
  }
}
